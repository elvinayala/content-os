      "parameters": {
        "jsCode": "// ID de la columna que quieres extraer\nconst targetColumnId = 'board_relation_mktnkez8';\n\n// Obtener todos los items de entrada\nconst items = $input.all();\n\n// Usamos map para transformar cada item\nconst results = items.map(item => {\n  // Asegurarnos de que item.json.column_values existe\n  const columnValues = item.json.column_values || [];\n  \n  // Encontrar la columna específica por su ID\n  const foundColumn = columnValues.find(col => col.id === targetColumnId);\n  \n  // Si no se encuentra la columna en este item, retornamos null\n  if (!foundColumn) {\n    return null;\n  }\n  \n  // Creamos una copia de la columna para no modificar el original\n  const columnData = { ...foundColumn };\n  \n  // --- Ayuda Opcional: Parsear el 'value' ---\n  // El campo 'value' viene como un string JSON.\n  // Este bloque intenta convertirlo en un objeto real.\n  if (columnData.value && typeof columnData.value === 'string') {\n    try {\n      // Solo intentar parsear si parece JSON\n      if (columnData.value.startsWith('{') || columnData.value.startsWith('[')) {\n        columnData.value = JSON.parse(columnData.value);\n      }\n    } catch (e) {\n      // Si falla (ej. no es JSON válido), se deja como string\n    }\n  }\n  // --- Fin de la ayuda opcional ---\n\n  // Retornamos el objeto de la columna en el formato de item de n8n\n  return {\n    json: columnData\n  };\n  \n}).filter(item => item !== null); // Filtramos todos los 'null' (items donde no se encontró la columna)\n\n// Retornamos el nuevo array de items\nreturn results;"
      },
