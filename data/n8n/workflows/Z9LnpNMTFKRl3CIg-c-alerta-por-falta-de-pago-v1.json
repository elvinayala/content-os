      {
        "parameters": {
          "jsCode": "const combinedData = items[0].json.data;\n\nif (!combinedData || combinedData.length === 0) {\n  return [];\n}\n\n// ## 1. Mapear los datos para una búsqueda eficiente\nconst clientDataMap = new Map();\nconst metaAccounts = [];\n\nfor (const item of combinedData) {\n  if (item.empresa) {\n    clientDataMap.set(item['ID-cuenta-publicitaria'], item);\n  } else if (item.account_status) {\n    metaAccounts.push(item);\n  }\n}\n\n// Mapeo de los códigos de estado\nconst statusMap = {\n  1: { text: 'Activa', emoji: '🟢' },\n  2: { text: 'Desactivada', emoji: '🔴' },\n  3: { text: 'Por Pagar', emoji: '🟠' },\n  9: { text: 'En Período de Gracia', emoji: '🟡' },\n};\n\nconst outputItems = [];\n\n// ## 2. Procesar cada cuenta y generar un item de salida si hay problemas\nfor (const account of metaAccounts) {\n  const status = account.account_status;\n\n  if (status !== 1) {\n    const individualBlocks = [];\n    const accountId = account.id.replace('act_', '');\n    const clientInfo = clientDataMap.get(accountId);\n\n    const statusInfo = statusMap[account.account_status] || { text: `Desconocido (${account.account_status})`, emoji: '⚫' };\n    const balanceFormatted = (parseInt(account.balance) / 100).toFixed(2);\n\n    let titleBlock = `*${clientInfo ? clientInfo.nombre : 'Cliente No Identificado'}* | ${clientInfo ? clientInfo.empresa : ''}`;\n    let idBlock = `*ID de Cuenta:* \\`${accountId}\\``;\n    let detailsBlock = `*Estado:* ${statusInfo.text}\\n*Saldo Pendiente:* $${balanceFormatted} USD`;\n\n    // Construye el mensaje para esta cuenta\n    individualBlocks.push({\n      \"type\": \"header\",\n      \"text\": {\n        \"type\": \"plain_text\",\n        \"text\": \"🔴 PROBLEMAS CON EL PAGO 🔴\",\n        \"emoji\": true\n      }\n    });\n\n    individualBlocks.push({\n      \"type\": \"section\",\n      \"text\": {\n        \"type\": \"mrkdwn\",\n        \"text\": `<!channel> <@U08U9777PUY>\\n\\n${titleBlock}\\n${idBlock}\\n\\n${detailsBlock}`\n      }\n    });\n\n    individualBlocks.push({ \"type\": \"divider\" });\n\n\n    // Añade el mensaje completo como un nuevo item al array de salida\n    outputItems.push({\n      json: {\n        text: `Alerta para ${clientInfo ? clientInfo.nombre : accountId}: ${statusInfo.text}`,\n        blocks: individualBlocks\n      }\n    });\n  }\n}\n\n// ## 3. Retornar el array de items\nreturn outputItems;"
        },
