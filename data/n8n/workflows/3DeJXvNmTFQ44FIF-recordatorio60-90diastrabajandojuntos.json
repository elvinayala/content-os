              "name": "query",
              "value": "query {\n  boards (ids: [8862995033]) {\n    items_page (\n      limit: 500,\n      query_params: {\n        operator: and,\n        rules: [\n          {\n            column_id: \"text_mkpqm0g9\",\n            operator: not_contains_text,\n            compare_value: [\"saldo completo\"]\n          },\n          {\n            column_id: \"group\",\n            operator: not_any_of,\n            compare_value: [\"group_mkqxsqsk\"]\n          }\n        ]\n      }\n    ) {\n      items {\n        id\n        name\n        group {\n          id\n          title\n        }\n        column_values {\n          id\n          type\n          text\n          value\n\n          ... on MirrorValue {\n            display_value\n          }\n\n          ... on BoardRelationValue {\n            linked_item_ids\n            display_value\n          }\n\n          ... on StatusValue {\n            label\n          }\n        }\n      }\n    }\n  }\n}\n"
            }
          ]
        },
