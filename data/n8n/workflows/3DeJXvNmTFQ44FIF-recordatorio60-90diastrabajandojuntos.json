    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Asumimos que la entrada viene de un nodo anterior de n8n o webhook\nconst item = $input.item.json;\n\nif (!item) {\n  return { error: \"No data received\" };\n}\n\n// 1. Helper blindado para extraer valores por título exacto\nconst getColValue = (colTitle) => {\n  if (!item.column_values) return null;\n  const col = item.column_values.find(c => c.column && c.column.title === colTitle);\n  return (col && col.text && col.text !== \"\") ? col.text : null;\n};\n\n// 2. Extracción de datos\nconst data = {\n  nombre: item.name || \"Sin Nombre\",\n  negocio: getColValue(\"Negocio\") || \"Sin Negocio\",\n  acuerdo: getColValue(\"ACUERDO OFRECIDO\") || \"—\",\n  finalizaAcuerdo: getColValue(\"finaliza acuerdo\") || new Date().toISOString().slice(0, 10).replace(/-/g, \"-\"),\n\n  \n  // Status Específicos\n  estadoGeneral: (item.column_values.find(c => c.id === 'status') || {}).text || getColValue(\"Estado\") || \"Sin estado\",\n  \n  // Textos largos\n  comentario: getColValue(\"COMENTARIOS\"),\n  statusTexto: getColValue(\"status\") // Columna de texto final\n};\n\n// 3. Lógica visual de Emojis\nconst getStatusEmoji = (status) => {\n  if (!status) return \"⚪\";\n  const s = status.toUpperCase();\n  if (s.includes(\"ON\") || s.includes(\"PAGÓ\") || s.includes(\"LISTO\")) return \"🟢\";\n  if (s.includes(\"OFF\") || s.includes(\"PROBLEMAS\") || s.includes(\"ERROR\")) return \"🔴\";\n  if (s.includes(\"PENDIENTE\") || s.includes(\"REVISIÓN\")) return \"🟡\";\n  return \"🔵\";\n};\n\n// 4. Construcción de Bloques Fijos\nconst blocks = [\n  {\n    \"type\": \"header\",\n    \"text\": {\n      \"type\": \"plain_text\",\n      \"text\": `Acuerdo se venció (90 dias) para: ${data.nombre}`,\n      \"emoji\": true\n    }\n  },\n  {\n    \"type\": \"section\",\n    \"text\": {\n      \"type\": \"mrkdwn\",\n      \"text\": \"<@U091X0MQXV0>\"\n    }\n  },\n  {\n    \"type\": \"section\",\n    \"fields\": [\n      {\n        \"type\": \"mrkdwn\",\n        \"text\": `*🏢 Negocio:*\\n${data.negocio}`\n      },\n      {\n        \"type\": \"mrkdwn\",\n        \"text\": `*🔖 Finalizacion Acuerdo:*\\n${data.finalizaAcuerdo}`\n      }\n    ]\n  },\n  {\n    \"type\": \"divider\"\n  },\n  {\n    \"type\": \"section\",\n    \"fields\": [\n      {\n        \"type\": \"mrkdwn\",\n        \"text\": `*🤝 Acuerdo:*\\n${data.acuerdo}`\n      }\n    ]\n  }\n];\n\nblocks.push({\n  \"type\": \"context\",\n  \"elements\": [\n    {\n      \"type\": \"plain_text\",\n      \"text\": `Recuerda hablar con el cliente, hoy se vence el contrato. `,\n      \"emoji\": true\n    }\n  ]\n});\n\n// 6. Footer Limpio (Solo ID)\nblocks.push({\n  \"type\": \"context\",\n  \"elements\": [\n    {\n      \"type\": \"plain_text\",\n      \"text\": `ID: ${item.id}`,\n      \"emoji\": true\n    }\n  ]\n});\n\nreturn { blocks };"
      },
