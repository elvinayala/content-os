    {
      "parameters": {
        "jsCode": "// Paso 1: Obtener las fechas de la nueva solicitud desde el \"Information Extractor\".\n// NOTA: Revisa que el nombre de tu nodo sea \"Information Extractor\". Si tiene otro nombre, ajústalo.\nconst nuevaSolicitud = $node[\"Information Extractor\"].json.output;\nconst newStartDate = new Date(nuevaSolicitud.fechaInicio);\nconst newEndDate = new Date(nuevaSolicitud.fechaFin);\n\n// Paso 2: Obtener la lista de vacaciones ya aprobadas que encontró el nodo Google Sheets anterior.\n// NOTA: Revisa el nombre de tu nodo \"Get row(s) in sheet\" que busca los solapamientos. Si se llama,\n// por ejemplo, \"Get row(s) in sheet1\", debes cambiarlo abajo.\nconst vacacionesAprobadas = $items(\"Get row(s) in sheet1\");\n\n// Paso 3: Inicializar la variable que nos dirá si hay un conflicto.\nlet overlapFound = false;\n\n// Paso 4: Revisar cada una de las vacaciones ya aprobadas.\nfor (const vacacion of vacacionesAprobadas) {\n  const existingStartDate = new Date(vacacion.json.FechaInicio);\n  const existingEndDate = new Date(vacacion.json.FechaFin);\n\n  // Esta es la lógica clave para detectar si los rangos se solapan.\n  if (newStartDate <= existingEndDate && newEndDate >= existingStartDate) {\n    overlapFound = true;\n    break; // Si encontramos un solapamiento, no necesitamos seguir buscando.\n  }\n}\n\n// Paso 5: Devolver un resultado simple: ¿hubo solapamiento o no?\nreturn [{\n  json: {\n    solapamiento: overlapFound\n  }\n}];"
      },
