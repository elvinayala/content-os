    {
      "parameters": {
        "jsCode": "// Obtener los datos de Supabase\nconst supabaseResult = $input.first().json;\n\n// Obtener los datos originales del loop\nconst loopData = $('Loop Over Items4').first().json;\n\n// CREAR LA CLAVE ÚNICA COMPUESTA (meeting_id + fecha)\nconst startDate = new Date(loopData.start_time).toISOString().split('T')[0]; // YYYY-MM-DD\nconst uniqueMeetingKey = `${loopData.zoom_meeting_id}_${startDate}`;\n\nconst originalData = {\n  \"uuid\": loopData.uuid,\n  \"zoom_meeting_id\": uniqueMeetingKey, // USAR LA CLAVE ÚNICA COMPUESTA\n  \"host_id\": loopData.host_id,\n  \"topic\": loopData.topic,\n  \"meeting_type\": loopData.meeting_type,\n  \"start_time\": loopData.start_time,\n  \"duration\": loopData.duration,\n  \"join_url\": loopData.join_url,\n  \"transcription_url\": loopData.transcription_url,\n  \"timezone\": \"America/Bogota\"\n};\n\n// LOG PARA DEBUG\nconsole.log('🔍 VALIDACIÓN CON CLAVE ÚNICA COMPUESTA:');\nconsole.log('   • Meeting ID original:', loopData.zoom_meeting_id);\nconsole.log('   • Fecha reunión:', startDate);\nconsole.log('   • Clave única generada:', uniqueMeetingKey);\nconsole.log('   • Supabase Result:', JSON.stringify(supabaseResult));\n\n// VALIDACIÓN: Verificar si existe usando la clave única\nif (!supabaseResult || Object.keys(supabaseResult).length === 0) {\n  console.log('❌ NO EXISTE en BD - Procesando reunión:', loopData.topic);\n  console.log('   • UUID Zoom:', loopData.uuid);\n  console.log('   • Clave única:', uniqueMeetingKey);\n  \n  // NO existe, devolver para procesar\n  return [{\n    json: {\n      ...originalData\n    }\n  }];\n} else {\n  console.log('✅ YA EXISTE en BD - Omitiendo reunión');\n  console.log('   • UUID encontrado:', supabaseResult.uuid);\n  console.log('   • Clave única:', supabaseResult.zoom_meeting_id);\n  console.log('   • Tema:', supabaseResult.topic || 'N/A');\n  \n  // YA existe, no devolver nada (skip)\n  return { \"response\": \"existe\" };\n}"
      },
