    {
      "parameters": {
        "functionCode": "// =================================================================\n// NODO 1: \"Map Recordings with Unique Key\" (Function Node)\n// =================================================================\n// Reemplaza tu nodo \"Map Recordings1\"\n\nreturn items.map(item => {\n  const meeting = item.json || item;\n  \n  // Buscar grabación de audio (M4A)\n  const audioFile = meeting.recording_files?.find(file => file.file_type === \"M4A\");\n  \n  // Crear clave única: zoom_meeting_id + fecha\n  const startDate = new Date(meeting.start_time).toISOString().split('T')[0]; // YYYY-MM-DD\n  const uniqueKey = `${meeting.id}_${startDate}`;\n  \n  console.log(`📅 Procesando reunión: ${meeting.topic} - Clave única: ${uniqueKey}`);\n  \n  return {\n    json: {\n      uuid: meeting.uuid,\n      zoom_meeting_id: String(meeting.id),\n      meeting_date: startDate,\n      unique_meeting_key: uniqueKey, // NUEVA CLAVE ÚNICA\n      host_id: meeting.host_id,\n      topic: meeting.topic,\n      meeting_type: String(meeting.type),\n      start_time: meeting.start_time,\n      duration: String(meeting.duration) || 60,\n      timezone: meeting.timezone || 'America/Bogota',\n      join_url: meeting.join_url || meeting.share_url || null,\n      transcription_url: audioFile ? audioFile.download_url : null\n    }\n  };\n});\n\n// =================================================================\n// NODO 2: \"Extract Unique Keys\" (Function Node)\n// =================================================================\n// Nuevo nodo para extraer las claves únicas\n\nconst meetings = items.map(item => item.json);\n\n// Extraer todas las claves únicas para verificación\nconst uniqueKeys = meetings.map(meeting => meeting.unique_meeting_key);\nconst uniqueKeysSet = [...new Set(uniqueKeys)]; // Eliminar duplicados\n\nconsole.log(`📊 EXTRACCIÓN DE CLAVES:`);\nconsole.log(`   • Total reuniones: ${meetings.length}`);\nconsole.log(`   • Claves únicas: ${uniqueKeysSet.length}`);\nconsole.log(`   • Primeras claves:`, uniqueKeysSet.slice(0, 3));\n\nreturn [{\n  json: {\n    allMeetings: meetings,\n    uniqueKeysToCheck: uniqueKeysSet\n  }\n}];\n\n\n// Obtener todas las claves existentes de Supabase\nconst existingRecords = $input.first().json || [];\nconst { allMeetings, uniqueKeysToCheck } = $('Extract Unique Keys').first().json;\n\n// Crear Set de claves existentes para búsqueda O(1)\nconst existingKeys = new Set(\n  existingRecords.map(record => record.unique_meeting_key)\n);\n\n// Filtrar solo reuniones que NO están en BD\nconst newMeetings = allMeetings.filter(meeting => \n  !existingKeys.has(meeting.unique_meeting_key)\n);\n\n// Logs detallados\nconsole.log(`📊 VERIFICACIÓN MASIVA DE CLAVES ÚNICAS:`);\nconsole.log(`   • Total claves en BD: ${existingRecords.length}`);\nconsole.log(`   • Claves a verificar: ${uniqueKeysToCheck.length}`);\nconsole.log(`   • Ya procesadas: ${uniqueKeysToCheck.filter(key => existingKeys.has(key)).length}`);\nconsole.log(`   • Nuevas a procesar: ${newMeetings.length}`);\n\n// Mostrar ejemplos de claves existentes vs nuevas\nif (existingKeys.size > 0) {\n  console.log(`✅ Ejemplos de claves existentes:`, [...existingKeys].slice(0, 3));\n}\n\nif (newMeetings.length > 0) {\n  console.log(`🆕 Nuevas reuniones a procesar:`);\n  newMeetings.slice(0, 3).forEach(meeting => {\n    console.log(`   • ${meeting.unique_meeting_key}: ${meeting.topic} (${meeting.meeting_date})`);\n  });\n  \n  if (newMeetings.length > 3) {\n    console.log(`   • ... y ${newMeetings.length - 3} reuniones más`);\n  }\n} else {\n  console.log(`ℹ️  Todas las reuniones ya están procesadas para estas fechas.`);\n  console.log(`🔄 Flujo terminado - no hay nada nuevo que procesar.`);\n}\n\n// Retornar solo las reuniones nuevas\nreturn newMeetings.map(meeting => ({ json: meeting }));\n\n"
      },
