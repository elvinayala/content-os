        "id": "5d8dba00-32f0-4d1f-932d-01467d56ec16",
        "name": "If"
      },
      {
        "parameters": {
          "jsCode": "// CONFIGURACIÓN: IDs de columnas en Monday\nconst COL_ID_INICIO = 'date'; \nconst COL_ID_FIN = 'date_mkyazdf8';\n\n// 1. Obtener fechas solicitadas (Formato ISO directo)\nconst triggerData = $('Input').first().json;\nconst newStartDate = new Date(triggerData.fechaInicio);\nconst newEndDate = new Date(triggerData.fechaFin);\n\n// 2. Obtener datos de Monday (Input inmediato)\nconst itemsMonday = $input.all();\n\n// VALIDACIÓN CRÍTICA: Si el input está vacío, no hay solapamiento posible.\nif (itemsMonday.length === 0) {\n  return [{ json: { solapamiento: false } }];\n}\n\nlet overlapFound = false;\n\n// 3. Iterar y comparar\nfor (const item of itemsMonday) {\n  // Protección contra items vacíos o mal formados\n  if (!item.json || !item.json.column_values) continue;\n\n  const columns = item.json.column_values;\n\n  // Extraer valores de las columnas específicas\n  const colInicio = columns.find(c => c.id === COL_ID_INICIO);\n  const colFin = columns.find(c => c.id === COL_ID_FIN);\n\n  // Si la fila en Monday no tiene fechas definidas, la ignoramos\n  if (!colInicio || !colFin || !colInicio.text || !colFin.text) continue;\n\n  const existingStartDate = new Date(colInicio.text);\n  const existingEndDate = new Date(colFin.text);\n\n  // Lógica de Solapamiento\n  if (newStartDate <= existingEndDate && newEndDate >= existingStartDate) {\n    overlapFound = true;\n    break; \n  }\n}\n\nreturn [{\n  json: {\n    solapamiento: overlapFound\n  }\n}];"
        },
