    {
      "parameters": {
        "jsCode": "// Obtenemos los datos de la nueva solicitud desde el Webhook inicial.\nconst nuevaSolicitud = $node[\"Webhook\"].json.body;\nconst newStartDate = new Date(nuevaSolicitud.fechaInicio);\nconst newEndDate = new Date(nuevaSolicitud.fechaFin);\n\n// Obtenemos la lista de vacaciones ya aprobadas del nodo anterior.\nconst vacacionesAprobadas = $items(\"Get row(s) in sheet1\");\n\nlet overlapFound = false;\n\n// Revisamos cada una de las vacaciones ya aprobadas.\nfor (const vacacion of vacacionesAprobadas) {\n  const existingStartDate = new Date(vacacion.json.FechaInicio);\n  const existingEndDate = new Date(vacacion.json.FechaFin);\n\n  // Esta es la lógica clave para detectar si los rangos se solapan.\n  if (newStartDate <= existingEndDate && newEndDate >= existingStartDate) {\n    overlapFound = true;\n    break; // Si encontramos un solapamiento, no necesitamos seguir buscando.\n  }\n}\n\n// Devolvemos un resultado simple: ¿hubo solapamiento o no?\nreturn [{\n  json: {\n    solapamiento: overlapFound\n  }\n}];"
      },
