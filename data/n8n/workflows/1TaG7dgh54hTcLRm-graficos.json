    {
      "parameters": {
        "jsCode": "// Obtener todos los binarios del item actual\nconst binaries = items[0].binary;\nconst dataPayload = { anuncios: [] };\n\n// Helper para convertir Buffer a Data URI\nfunction bufferToDataURI(buffer, mimeType) {\n  return `data:${mimeType};base64,${buffer.toString('base64')}`;\n}\n\n// 1. Procesar Template (PPTX)\n// Carbone suele querer el base64 sin prefijo para el template\nif (binaries.template) {\n  const buffer = await this.helpers.getBinaryDataBuffer(0, 'template');\n  // Guardamos solo el base64 raw\n  items[0].json.templateBase64 = buffer.toString('base64');\n}\n\n// 2. Procesar Gráfica Principal ('data')\nif (binaries.data) {\n  const buffer = await this.helpers.getBinaryDataBuffer(0, 'data');\n  dataPayload.grafico_principal = bufferToDataURI(buffer, binaries.data.mimeType);\n}\n\n// 3. Procesar Anuncios ('data_1', 'data_2', etc.)\nfor (let i = 1; i <= 4; i++) {\n  const key = `data_${i}`;\n  if (binaries[key]) {\n    const buffer = await this.helpers.getBinaryDataBuffer(0, key);\n    \n    // DETECCIÓN DE VIDEO: Si es MP4, ponemos un placeholder por ahora\n    if (binaries[key].mimeType.includes('video')) {\n       // OJO: Carbone Community no renderiza video base64. \n       // Aquí podrías poner una imagen estática \"play icon\" en base64 si quieres.\n       // Por ahora lo mandamos igual a ver si tu versión lo acepta o lo ignora.\n       dataPayload.anuncios.push({ \n         imagen: bufferToDataURI(buffer, binaries[key].mimeType) \n       });\n    } else {\n       // Es imagen, todo ok\n       dataPayload.anuncios.push({ \n         imagen: bufferToDataURI(buffer, binaries[key].mimeType) \n       });\n    }\n  }\n}\n\n// 4. Salida final\nreturn {\n  json: {\n    template: items[0].json.templateBase64,\n    data: dataPayload\n  }\n};\n"
      },
