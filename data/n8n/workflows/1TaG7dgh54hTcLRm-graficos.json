    {
      "parameters": {
        "jsCode": "// 1. FILTRADO INICIAL (Añadido para evitar el error)\n// Filtramos para quedarnos solo con campañas que tengan insights y datos dentro\nconst campaigns = $input.first().json.data.filter(c => \n  c.insights && \n  c.insights.data && \n  c.insights.data.length > 0\n);\n\nconst labels = [];\nconst dataSpend = [];\nconst dataImpressions = [];\nconst dataCPM = [];\n\ncampaigns.forEach(camp => {\n  // LOGICA DE NOMBRES\n  const parts = camp.name.split('/').map(s => s.trim());\n  let shortName = parts[1] || camp.name; // Fallback por si el split falla\n  const format = parts.find(p => ['IMG', 'VID', 'CARRUSEL'].includes(p));\n  if (format) shortName += ` ${format}`;\n   \n  labels.push(shortName);\n\n  // AQUI YA ES SEGURO ACCEDER\n  const insights = camp.insights.data[0];\n   \n  // LIMPIEZA DE DATOS\n  dataSpend.push(Math.round(parseFloat(insights.spend || 0)));\n  dataImpressions.push(Math.round(parseFloat(insights.impressions || 0)));\n  dataCPM.push(Number(parseFloat(insights.cpm || 0).toFixed(2)));\n});\n\n// Colores\nconst colorSpend = '#003768'; \nconst colorImp = '#60A5FA';    \nconst colorCPM = '#6B7280';    \n\nconst chartConfig = {\n  type: 'bar',\n  data: {\n    labels: labels,\n    datasets: [\n      {\n        type: 'bar',\n        label: 'Inversión',\n        backgroundColor: colorSpend,\n        data: dataSpend,\n        yAxisID: 'y-spend',\n        order: 2,\n        barPercentage: 0.8,\n        categoryPercentage: 0.8,\n        datalabels: {\n          align: 'end',\n          anchor: 'end',\n          color: colorSpend,\n          font: { weight: 'bold', size: 11 }\n        }\n      },\n      {\n        type: 'bar',\n        label: 'Impresiones',\n        backgroundColor: colorImp,\n        data: dataImpressions,\n        yAxisID: 'y-imp',\n        order: 3,\n        barPercentage: 0.8,\n        categoryPercentage: 0.8,\n        datalabels: { display: false }\n      },\n      {\n        type: 'line',\n        label: 'CPM',\n        borderColor: colorCPM,\n        backgroundColor: 'white',\n        pointBorderColor: colorCPM,\n        pointBorderWidth: 3,\n        pointRadius: 5,\n        borderWidth: 3,\n        fill: false,\n        data: dataCPM,\n        yAxisID: 'y-cpm',\n        tension: 0.1,\n        order: 1,\n        datalabels: {\n          align: 'top',\n          color: 'white',\n          backgroundColor: colorCPM,\n          borderRadius: 4,\n          font: { weight: 'bold', size: 10 },\n          padding: 6,\n          offset: 4\n        }\n      }\n    ]\n  },\n  options: {\n    title: {\n      display: true,\n      text: 'META ADS - RENDIMIENTO ($ USD)',\n      fontSize: 22,\n      fontColor: '#111827',\n      padding: 24,\n      fontStyle: 'bold',\n      fontFamily: 'sans-serif'\n    },\n    legend: {\n      position: 'bottom',\n      labels: { padding: 20, usePointStyle: true }\n    },\n    layout: {\n      padding: { top: 40, left: 10, right: 10, bottom: 10 }\n    },\n    scales: {\n      xAxes: [{\n        gridLines: { display: false },\n        ticks: { fontStyle: 'bold', fontSize: 11, fontColor: '#374151' }\n      }],\n      yAxes: [\n        {\n          id: 'y-spend',\n          type: 'linear',\n          position: 'left',\n          gridLines: { display: true, color: '#F3F4F6', borderDash: [5, 5] },\n          ticks: { \n            beginAtZero: true,\n            fontColor: colorSpend\n          },\n          scaleLabel: { display: true, labelString: 'Inversión ($)', fontColor: colorSpend }\n        },\n        {\n          id: 'y-imp',\n          type: 'linear',\n          position: 'right',\n          gridLines: { display: false },\n          ticks: { beginAtZero: true, fontColor: colorImp }, \n          scaleLabel: { display: true, labelString: 'Impresiones', fontColor: colorImp }\n        },\n        {\n          id: 'y-cpm',\n          type: 'linear',\n          position: 'right',\n          display: false, \n          ticks: { beginAtZero: false, suggestedMin: 0, suggestedMax: 20 }\n        }\n      ]\n    },\n    plugins: {\n      datalabels: { display: true }\n    }\n  }\n};\n\nreturn { json: { chartConfig } };"
      },
