    {
      "parameters": {
        "jsCode": "// 1. Obtenemos el dato del mensaje original desde un nodo anterior.\n// Usar .first() es una buena práctica para asegurar que solo procesas un ítem.\nconst mensajeOriginal = $input.first().json.message.documentMessage.caption;\n\n// 2. Construimos el objeto JavaScript con la estructura CORRECTA.\n// El 'content' está al mismo nivel que 'type', sin el objeto 'data'.\nconst messageObject = {\n  type: \"ai\",\n  content: mensajeOriginal,\n  // -------------------------------------------------------------------\n  // Estas claves adicionales hacen que tu mensaje sea idéntico a uno\n  // generado por el agente, aunque no siempre son estrictamente necesarias.\n  additional_kwargs: {},\n  tool_calls: [],\n  invalid_tool_calls: [],\n  response_metadata: {}\n  // -------------------------------------------------------------------\n};\n\n// 3. Convertimos el objeto a un string JSON para pasarlo al nodo de PostgreSQL.\nconst jsonParaPostgres = JSON.stringify(messageObject);\n\n// 4. Devolvemos los datos que usará el siguiente nodo (PostgreSQL).\nreturn [\n  {\n    json: {\n      messageJsonString: jsonParaPostgres,\n      // Pasamos también el session_id para usarlo en la consulta SQL.\n      sessionId: $input.first().json.key.remoteJid\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
