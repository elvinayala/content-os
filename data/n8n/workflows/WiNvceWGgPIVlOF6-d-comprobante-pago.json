    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Este código se ejecuta para cada empleado\n\n// 1. Obtenemos el objeto del item actual\nconst item = $input.item;\n\n// 2. Accedemos al archivo PDF que viene en la propiedad 'data'\nconst pdfFile = item.binary.data;\n\n// 3. Obtenemos el nombre y el periodo de los datos del NODO \"get-payroll-data\"\nconst nombreEmpleado = $('get-payroll-data').item.json.EMPLEADO;\nconst periodoPago = $('get-payroll-data').item.json.PERIODO;\n\n// 4. Creamos el nuevo nombre para el archivo\nconst nuevoNombre = `Comprobante de Pago - ${nombreEmpleado} - ${periodoPago}.pdf`;\n\n// 5. Asignamos el nuevo nombre a la propiedad 'fileName' del PDF\npdfFile.fileName = nuevoNombre;\n\n// 6. Devolvemos el item completo, ya con el nombre del archivo corregido\nreturn item;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
