    {
      "parameters": {
        "functionCode": "const today = new Date();\nreturn items.map(item => {\n  // 1) Convertir la cadena a número de milisegundos\n  const millis = Number(item.json.due_date);\n  // 2) Crear la fecha correctamente\n  const due = new Date(millis);\n  // 3) Calcular diferencia en días\n  const diffDays = Math.ceil((due - today) / (1000 * 60 * 60 * 24));\n  return { json: { ...item.json, diffDays } };\n});\n"
      },
      "id": "616abf5d-aa2c-429f-8bbb-f76fa93518b7",
      "name": "Calculate diffDays",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [
        1184,
        144
      ]
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{ $json.diffDays }}",
              "operation": "equal",
              "value2": 2
            }
          ]
        }
      },
      "id": "bd736da7-76e9-4c08-9f21-5789c515a3a4",
      "name": "IF: Reminder?",
