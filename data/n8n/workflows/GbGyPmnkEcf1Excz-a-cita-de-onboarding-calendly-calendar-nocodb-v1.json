          ],
          "description": "={{ JSON.stringify({ 'First-name': $json.nombre, 'Last-name': $json.apellido, 'phone-number': $json.telefono, 'meeting-zoom': $json.zoomLink, 'uuid-event': $json.uri }) }}",
          "location": "={{ $json.zoomLink }}",
          "summary": "={{ $json.eventName }} - {{ $json.nombreCompleto }}"
        }
      },
