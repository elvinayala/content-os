      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const d = $('¿Buscar campañas?').item.json;\nconst lista = Array.isArray($json.data) ? $json.data : [];\nconst lu = lista.filter((c) => /level ?up/i.test(c.name || '')).sort((a, b) => String(a.created_time).localeCompare(String(b.created_time)));\nconst fecha = lu.length ? String(lu[0].created_time).slice(0, 10) : null;\nreturn { json: { filaId: d.filaId, fecha, actual: d.fila ? d.fila['fecha-inicio-campaña'] : null } };"
