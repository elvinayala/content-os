    {
      "id": "n-normalizar",
      "name": "Normalizar",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        520,
        0
      ],
      "parameters": {
        "jsCode": "// Un item por cliente, venga del webhook (body.clientes) o de la corrida nocturna (clientes).\nconst salida = [];\nfor (const item of $input.all()) {\n  const j = item.json || {};\n  const cuerpo = j.body && typeof j.body === 'object' ? j.body : j;\n  const lote = Array.isArray(cuerpo.clientes) ? cuerpo.clientes : [];\n  for (const c of lote) {\n    if (!c || !c.idMonday) continue;\n    salida.push({ json: { ...c, simulacion: cuerpo.simulacion !== false, motivo: cuerpo.motivo || 'nocturna' } });\n  }\n}\nreturn salida;"
      }
    },
