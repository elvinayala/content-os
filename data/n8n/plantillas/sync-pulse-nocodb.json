    {
      "id": "n-elegir-destino",
      "name": "Elegir destino",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2860,
        -200
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const plan = $('Plan de links').item.json;\nconst filas = ($json.list) || [];\nlet hit = null;\nif (plan.tabla === 'm0uib6kq4i1gelp') {\n  const p = plan.persona || {};\n  hit = (p.idMonday && filas.find((f) => String(f['ID-monday'] || '') === String(p.idMonday)))\n     || (p.email && filas.find((f) => String(f.email || '').trim().toLowerCase() === String(p.email).trim().toLowerCase()))\n     || null;\n} else {\n  const n = String(plan.valor || '').trim().toLowerCase();\n  hit = n ? filas.find((f) => String(f.nombre || '').trim().toLowerCase() === n) || null : null;\n}\nconst nuevoId = hit ? hit.Id : null;\nlet accionLink = 'nada';\nif (nuevoId !== plan.actual) accionLink = plan.actual ? (nuevoId ? 'reemplazar' : 'quitar') : (nuevoId ? 'poner' : 'nada');\nreturn { json: { ...plan, nuevoId, destino: hit ? (hit.nombre || '') : null, accionLink } };"
      }
    },
