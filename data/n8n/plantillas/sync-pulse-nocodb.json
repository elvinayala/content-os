        "url": "https://levelup-media-project-nocodb.ksnxqw.easypanel.host/api/v2/tables/mom1ynk05ap3m1l/records",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "nocoDbApiToken",
        "options": {},
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "where",
              "value": "=(ID-monday,eq,{{ $json.idMonday }})"
            },
            {
              "name": "limit",
              "value": "1"
            }
          ]
        }
      },
      "credentials": {
        "nocoDbApiToken": {
          "id": "V2awKCkA1AJCFG27",
          "name": "NocoDB Token account"
        }
      }
    },
    {
      "id": "n-decidir",
      "name": "Decidir",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1040,
        0
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const c = $('Normalizar').item.json;\nconst fila = (($json.list) || [])[0] || null;\nconst tel = String(c.telefono || '').replace(/\\D/g, '');\nconst campos = {\n  'ID-monday': String(c.idMonday),\n  nombre: c.nombre || '',\n  empresa: c.empresa || '',\n  'ID-cuenta-publicitaria': c.idCuenta || '',\n  email: c.email || '',\n  telefono: tel ? Number(tel) : null,\n};\nlet accion = 'nada';\nif (c.activo && !fila) accion = 'crear';\nelse if (c.activo && fila) accion = 'actualizar';\nelse if (!c.activo && fila) accion = 'borrar';\nconst cambios = fila\n  ? Object.keys(campos).filter((k) => k !== 'ID-monday' && String(fila[k] ?? '') !== String(campos[k] ?? ''))\n  : Object.keys(campos);\nif (c.simulacion && accion !== 'nada') accion = 'simular';\nconst cuentaCambio = !fila || String(fila['ID-cuenta-publicitaria'] ?? '') !== campos['ID-cuenta-publicitaria'];\nreturn { json: { accion, motivo: c.motivo, cliente: c, fila, filaId: fila ? fila.Id : null, campos, cambios, cuentaCambio, resumen: accion + ' ' + c.nombre + (cambios.length ? ' [' + cambios.join(', ') + ']' : '') } };"
      }
    },
