      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2340,
        -200
      ],
      "parameters": {
        "jsCode": "// Por cliente: 3 links (traffiker, admin → equipo; industria → industrias).\nconst out = [];\nfor (const it of $input.all()) {\n  const { cliente: c, fila, filaId } = it.json;\n  if (!filaId) continue;\n  out.push({ json: { filaId, nombre: 'traffiker', linkCol: 'ct33f49i8som5rx', tabla: 'm0uib6kq4i1gelp', persona: c.traffiker || {}, actual: fila && fila.traffiker ? fila.traffiker.Id : null } });\n  out.push({ json: { filaId, nombre: 'admin', linkCol: 'c2c88wzry5od96o', tabla: 'm0uib6kq4i1gelp', persona: c.admin || {}, actual: fila && fila.admin ? fila.admin.Id : null } });\n  out.push({ json: { filaId, nombre: 'industrias', linkCol: 'c7xyj70esnqjve0', tabla: 'mur2zaymbw5791i', valor: c.industria || '', actual: fila && fila.industrias ? fila.industrias.Id : null } });\n}\nreturn out;"
      }
