            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Resultado": {
      "main": [
        [
          {
            "node": "Memoria del agente",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Memoria del agente": {
