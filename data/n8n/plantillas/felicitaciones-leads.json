    {
      "id": "f-candidatos",
      "name": "Candidatos",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        780,
        0
      ],
      "parameters": {
        "jsCode": "// Clientes con cuenta publicitaria, fecha de inicio y sin la felicitación de 200 todavía.\nconst real = $('Modo programado').isExecuted ? $('Modo programado').first().json.real : false;\n// sembrar (una sola vez, por webhook): marca como ya felicitados a los que pasaron de 200 sin mandarles nada.\nconst sembrar = $('Modo simulación').isExecuted ? $('Modo simulación').first().json.sembrar === true : false;\nconst hoy = new Date().toLocaleDateString('en-CA', { timeZone: 'America/Puerto_Rico' });\nconst out = [];\nfor (const f of ($json.list || [])) {\n  const cuenta = String(f['ID-cuenta-publicitaria'] || '').replace(/\\D/g, '');\n  const inicio = String(f['fecha-inicio-campaña'] || '').slice(0, 10);\n  const fel = String(f.felicitaciones ?? '').trim();\n  if (!cuenta || !/^\\d{4}-\\d{2}-\\d{2}$/.test(inicio) || fel === '200') continue;\n  out.push({ json: { id: f.Id, nombre: f.nombre || '', empresa: f.empresa || '', telefono: String(f.telefono || '').replace(/\\D/g, ''), cuenta, inicio, hoy, felicitaciones: fel, real, sembrar } });\n}\nreturn out;"
      }
    },
