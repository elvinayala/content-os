      "name": "Traer equipo de Pulse",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        260,
        0
      ],
      "parameters": {
        "url": "https://content-os-chi-seven.vercel.app/api/pulse/n8n/equipo",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 60000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "vDGtt7BxftPjeHjM",
          "name": "Pulse ↔ n8n (x-pulse-secret)"
        }
      }
    },
    {
      "id": "n-equipo-en-nocodb",
      "name": "Equipo en NocoDB",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        520,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "https://levelup-media-project-nocodb.ksnxqw.easypanel.host/api/v2/tables/m0uib6kq4i1gelp/records?limit=500",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "nocoDbApiToken",
        "options": {
          "batching": {
            "batch": {
              "batchSize": 1,
              "batchInterval": 150
            }
          }
        }
      },
      "credentials": {
        "nocoDbApiToken": {
          "id": "V2awKCkA1AJCFG27",
          "name": "NocoDB Token account"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "onError": "stopWorkflow"
    },
    {
      "id": "n-decidir-equipo",
      "name": "Decidir equipo",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        780,
        0
      ],
      "parameters": {
        "jsCode": "const pulse = $('Traer equipo de Pulse').first().json;\nconst personas = Array.isArray(pulse.personas) ? pulse.personas : [];\nconst filas = ($input.first().json.list) || [];\nconst norm = (s) => String(s || '').trim().toLowerCase();\nconst out = [];\nfor (const p of personas) {\n  const fila = (p.idMonday && filas.find((f) => String(f['ID-monday'] || '') === String(p.idMonday)))\n    || (p.email && filas.find((f) => norm(f.email) === norm(p.email)))\n    || (p.idColumnaCumpleanos && filas.find((f) => String(f['ID-columna-cumpleaños'] || '') === String(p.idColumnaCumpleanos)))\n    || null;\n  const campos = { nombre: p.nombre || '', email: p.email || '', 'ID-slack': p.idSlack || '' };\n  if (p.idMonday) campos['ID-monday'] = String(p.idMonday);\n  if (p.idColumnaCumpleanos) campos['ID-columna-cumpleaños'] = String(p.idColumnaCumpleanos);\n  let accion = fila ? 'actualizar' : 'crear';\n  const cambios = fila ? Object.keys(campos).filter((k) => String(fila[k] ?? '') !== String(campos[k] ?? '')) : Object.keys(campos);\n  if (fila && !cambios.length) accion = 'nada';\n  if (pulse.simulacion && accion !== 'nada') accion = 'simular';\n  out.push({ json: { accion, filaId: fila ? fila.Id : null, campos, cambios, resumen: accion + ' ' + (p.nombre || '') + (cambios.length ? ' [' + cambios.join(', ') + ']' : '') } });\n}\nreturn out;"
      }
    },
    {
      "id": "n--qu-hacer-",
      "name": "¿Qué hacer?",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [
        1040,
        0
      ],
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "loose",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "c1",
                    "leftValue": "={{ $json.accion }}",
                    "rightValue": "crear",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "crear"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "loose",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "c2",
                    "leftValue": "={{ $json.accion }}",
                    "rightValue": "actualizar",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "actualizar"
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra"
        }
      }
    },
