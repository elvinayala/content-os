            {
              "name": "where",
              "value": "=({{ $json.telefono ? '(telefono,eq,' + $json.telefono + ')~or' : '' }}(email,eq,{{ $json.email }}))"
            },
            {
              "name": "limit",
              "value": "1"
            }
          ]
        }
      },
      "credentials": {
        "nocoDbApiToken": {
