{
  "name": "A-) Cita de onboarding (Calendly → Calendar + NocoDB) v1",
  "nodes": [
    {
      "id": "n-nota",
      "name": "Nota",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        -400
      ],
      "parameters": {
        "width": 520,
        "height": 220,
        "content": "## Cita de onboarding v1\nReemplaza a \"E-) citas automaticas v4\" (leía los correos de Calendly en Gmail; dejó de correr en agosto 2026 y por eso nadie nuevo recibía bienvenida ni encuestas).\n\nLo llama **/api/calendly** de Content OS (webhook oficial de Calendly) solo para eventos de **Onboarding**. Payload plano: nombre, apellido, email, telefono, fecha (ISO), eventName, zoomLink, uri.\n\n1. Dedupe por email o teléfono en la base de onboarding.\n2. Evento en el Calendar de agenteia@ (mismo formato que el viejo: description JSON con First-name/phone/zoom/uuid).\n3. Fila en NocoDB onboarding (nombre, email, fecha, event-id, evento, telefono, fecha-formateada).\n\nFuente: scripts/n8n-sync-pulse.mjs."
      }
    },
    {
      "id": "n-webhook-cita",
      "name": "Webhook cita",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "onboarding-cita",
        "authentication": "headerAuth",
        "responseMode": "onReceived",
        "options": {}
      },
      "webhookId": "onboarding-cita-v1",
      "credentials": {
        "httpHeaderAuth": {
          "id": "vDGtt7BxftPjeHjM",
          "name": "Pulse ↔ n8n (x-pulse-secret)"
        }
      }
    },
    {
      "id": "n-normalizar-cita",
      "name": "Normalizar cita",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        260,
        0
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const b = $json.body || $json;\nconst tel = String(b.telefono || '').replace(/[^0-9]/g, '');\nconst nombre = String(b.nombre || '').trim();\nconst apellido = String(b.apellido || '').trim();\nreturn { json: {\n  nombre, apellido, nombreCompleto: [nombre, apellido].filter(Boolean).join(' '),\n  email: String(b.email || '').trim().toLowerCase(),\n  telefono: tel,\n  fecha: b.fecha,\n  fechaFormateada: String(b.fecha || '').slice(0, 10),\n  eventName: b.eventName || 'Onboarding',\n  zoomLink: b.zoomLink || '',\n  uri: b.uri || '',\n  simulacion: b.simulacion === true,\n} };"
      }
    },
    {
      "id": "n--ya-existe-",
      "name": "¿Ya existe?",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        520,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "https://levelup-media-project-nocodb.ksnxqw.easypanel.host/api/v2/tables/mc5m2od7vy71g6z/records",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "nocoDbApiToken",
        "options": {
          "batching": {
            "batch": {
              "batchSize": 1,
              "batchInterval": 150
            }
          }
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "where",
              "value": "=({{ $json.telefono ? '(telefono,eq,' + $json.telefono + ')~or' : '' }}(email,eq,{{ $json.email }}))"
            },
            {
              "name": "limit",
              "value": "1"
            }
          ]
        }
      },
      "credentials": {
        "nocoDbApiToken": {
          "id": "V2awKCkA1AJCFG27",
          "name": "NocoDB Token account"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "onError": "stopWorkflow"
    },
    {
      "id": "n-decidir-cita",
      "name": "Decidir cita",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        780,
        0
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const c = $('Normalizar cita').item.json;\nconst filas = ($json.list) || [];\nconst existe = filas.length > 0;\nreturn { json: { ...c, existe, accion: c.simulacion ? 'simular' : (existe ? 'nada' : 'crear'), filaExistente: filas[0] || null } };"
      }
    },
    {
      "id": "n--crear-",
      "name": "¿Crear?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1040,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.accion }}",
              "rightValue": "crear",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "n-evento-en-calendar",
      "name": "Evento en Calendar",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.3,
      "position": [
        1300,
        -200
      ],
      "parameters": {
        "calendar": {
          "__rl": true,
          "value": "agenteia@levelupmediapr.net",
          "mode": "list",
          "cachedResultName": "agenteia@levelupmediapr.net"
        },
        "start": "={{ $json.fecha }}",
        "end": "={{ $json.fecha.toDateTime().plus(1, 'hours') }}",
        "useDefaultReminders": false,
        "additionalFields": {
          "attendees": [
            "={{ $json.email }}"
          ],
          "description": "={{ JSON.stringify({ 'First-name': $json.nombre, 'Last-name': $json.apellido, 'phone-number': $json.telefono, 'meeting-zoom': $json.zoomLink, 'uuid-event': $json.uri }) }}",
          "location": "={{ $json.zoomLink }}",
          "summary": "={{ $json.eventName }} - {{ $json.nombreCompleto }}"
        }
      },
      "credentials": {
        "googleCalendarOAuth2Api": {
          "id": "OnmhBZjsVglHy8qy",
          "name": "GoogleCalendarLevelUpMedia"
        }
      },
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 3000,
      "onError": "continueRegularOutput"
    },
    {
      "id": "n-fila-en-onboarding",
      "name": "Fila en onboarding",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1560,
        -200
      ],
      "parameters": {
        "method": "POST",
        "url": "https://levelup-media-project-nocodb.ksnxqw.easypanel.host/api/v2/tables/mc5m2od7vy71g6z/records",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "nocoDbApiToken",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ nombre: $('Decidir cita').item.json.nombreCompleto, email: $('Decidir cita').item.json.email, fecha: $('Decidir cita').item.json.fecha, 'event-id': $json.id || '', evento: $('Decidir cita').item.json.eventName, telefono: $('Decidir cita').item.json.telefono, 'fecha-formateada': $('Decidir cita').item.json.fechaFormateada }) }}",
        "options": {
          "batching": {
            "batch": {
              "batchSize": 1,
              "batchInterval": 150
            }
          }
        }
      },
      "credentials": {
        "nocoDbApiToken": {
          "id": "V2awKCkA1AJCFG27",
          "name": "NocoDB Token account"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "onError": "continueRegularOutput"
    },
    {
      "id": "n-nada-ya-exist-a",
      "name": "Nada / ya existía",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        1300,
        200
      ],
      "parameters": {}
    }
  ],
  "connections": {
    "Webhook cita": {
      "main": [
        [
          {
            "node": "Normalizar cita",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Normalizar cita": {
      "main": [
        [
          {
            "node": "¿Ya existe?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "¿Ya existe?": {
      "main": [
        [
          {
            "node": "Decidir cita",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Decidir cita": {
      "main": [
        [
          {
            "node": "¿Crear?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "¿Crear?": {
      "main": [
        [
          {
            "node": "Evento en Calendar",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Nada / ya existía",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Evento en Calendar": {
      "main": [
        [
          {
            "node": "Fila en onboarding",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "fEOX9Q3Szkf6bLQq"
  }
}
