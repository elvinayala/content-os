# Remi en la nube (27/sep/2026): servicio de render de la fábrica de motion (motion/servicio/servidor.mjs).
# Chrome headless de Remotion + sus librerías del sistema. El código se baja de GitHub en cada trabajo
# (scripts/remi-nube.sh), igual que Max/Lola/Sofi. Deploy: npx @railway/cli up --service remi --detach
# Variables: REMI_SECRETO, SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, GIT_SSH_KEY_B64 (ref. a nico) o GH_TOKEN.
FROM node:22-bookworm-slim
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates git openssh-client curl tini \
      libnss3 libdbus-1-3 libatk1.0-0 libatk-bridge2.0-0 libgbm1 libasound2 libxrandr2 libxkbcommon0 \
      libxfixes3 libxcomposite1 libxdamage1 libpango-1.0-0 libcairo2 libcups2 libdrm2 libxshmfence1 \
      fonts-noto-color-emoji fonts-noto-core ffmpeg \
    && rm -rf /var/lib/apt/lists/*
# yt-dlp (23/oct): baja los videos de referencia ("hazlo como este Reel") para POST /referencia. Binario sin Python.
RUN curl -fsSL https://github.com/yt-dlp/yt-dlp/releases/download/2026.10.21/yt-dlp_linux -o /usr/local/bin/yt-dlp \
    && chmod +x /usr/local/bin/yt-dlp && yt-dlp --version
WORKDIR /app
COPY scripts/remi-nube.sh /app/remi-nube.sh
COPY data/plataformas.json /app/data/plataformas.json
ENV HOME=/estado REMI_REPO=/estado/repos/content-os
RUN mkdir -p /estado
CMD ["tini", "-s", "-g", "--", "bash", "/app/remi-nube.sh"]
# railway.json fija startCommand "node scripts/telegram-puente.mjs" para todos los servicios del proyecto: en esta imagen
# ese archivo es un atajo que arranca Remi (no hay puente de Telegram aquí).
# tini -s (17/oct): este atajo es el PID 1 y node no recoge los procesos huérfanos de Chrome; se acumulaban como zombis
# hasta agotar los procesos del contenedor (spawn EAGAIN desde el 16/oct: Remi colgado, los cierres de Cortex esperaban 5 min)
RUN mkdir -p /app/scripts && printf '%s\n' 'const { spawn } = require("node:child_process");' 'const p = spawn("tini", ["-s", "-g", "--", "bash", "/app/remi-nube.sh"], { stdio: "inherit" });' 'p.on("exit", (c) => process.exit(c ?? 1));' > /app/scripts/telegram-puente.cjs \
    && printf '%s\n' 'import "./telegram-puente.cjs";' > /app/scripts/telegram-puente.mjs
